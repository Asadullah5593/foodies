{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "seed": "ts-node -r tsconfig-paths/register src/seed.ts",
    "seed:menu": "ts-node -r tsconfig-paths/register src/seed-menu.ts",
    "seed:export-items": "ts-node -r tsconfig-paths/register src/seed-export-items.ts",
    "seed:wok-and-go": "ts-node -r tsconfig-paths/register src/seed-wok-and-go.ts",
    "seed:wok-and-go-real": "ts-node -r tsconfig-paths/register src/seed-wok-and-go-real.ts",
    "seed:wok-and-go-2026": "ts-node -r tsconfig-paths/register src/seed-wok-and-go-2026.ts",
    "seed:peri-peri-co": "ts-node -r tsconfig-paths/register src/seed-peri-peri-co.ts",
    "seed:peri-peri-co-real": "ts-node -r tsconfig-paths/register src/seed-peri-peri-co-real.ts",
    "seed:peperico-2026": "ts-node -r tsconfig-paths/register src/seed-peperico-2026.ts",
    "seed:fireaway": "ts-node -r tsconfig-paths/register src/seed-fireaway.ts",
    "seed:fireaway-real": "ts-node -r tsconfig-paths/register src/seed-fireaway-real.ts",
    "seed:fireaway-2026": "ts-node -r tsconfig-paths/register src/seed-fireaway-2026.ts",
    "seed:loranzo-real": "ts-node -r tsconfig-paths/register src/seed-loranzo-real.ts",
    "seed:loranzo-2026": "ts-node -r tsconfig-paths/register src/seed-loranzo-2026.ts",
    "seed:pizza-pasta": "ts-node -r tsconfig-paths/register src/seed-pizza-pasta.ts",
    "seed:inventory": "ts-node -r tsconfig-paths/register src/seed-inventory.ts",
    "seed:uoms": "ts-node -r tsconfig-paths/register src/seed-uoms.ts",
    "seed:brand-admins": "ts-node -r tsconfig-paths/register src/seed-brand-admins.ts",
    "seed:client-users": "ts-node -r tsconfig-paths/register src/seed-client-users.ts",
    "seed:shift-managers": "ts-node -r tsconfig-paths/register src/seed-shift-managers.ts",
    "seed:delivery-manager": "ts-node -r tsconfig-paths/register src/seed-delivery-manager.ts",
    "seed:invoice-templates": "ts-node -r tsconfig-paths/register src/seed-invoice-templates.ts",
    "seed:reset-password": "ts-node -r tsconfig-paths/register src/reset-demo-password.ts",
    "epg:smoke": "ts-node -r tsconfig-paths/register src/scripts/epg-smoke-test.ts",
    "typeorm": "node --loader ts-node/esm ./node_modules/typeorm/cli.js -d src/data-source.ts",
    "migration:run": "npm run build && node ./node_modules/typeorm/cli.js migration:run -d dist/data-source.js",
    "migration:revert": "node ./node_modules/typeorm/cli.js migration:revert -d dist/data-source.js",
    "migration:show": "node ./node_modules/typeorm/cli.js migration:show -d dist/data-source.js",
    "db:reset": "ts-node -r tsconfig-paths/register src/scripts/db-reset.ts",
    "backfill:employees": "ts-node -r tsconfig-paths/register src/scripts/backfill-employees.ts",
    "backfill:menu-images": "ts-node -r tsconfig-paths/register src/scripts/backfill-menu-image-variants.ts",
    "firebase:build-json": "node scripts/build-firebase-service-account-json.mjs",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "merge:rider-hrm": "ts-node -r tsconfig-paths/register src/scripts/merge-rider-hrm.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1015.0",
    "@aws-sdk/client-sns": "^3.1015.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.19",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.2.5",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.19",
    "@types/nodemailer": "^7.0.11",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "firebase-admin": "^13.10.0",
    "nodemailer": "^8.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.18.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "typeorm": "^0.3.20",
    "typeorm-naming-strategies": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/babel__generator": "^7.6.8",
    "@types/babel__template": "^7.4.4",
    "@types/babel__traverse": "^7.28.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/body-parser": "^1.19.6",
    "@types/express": "^5.0.0",
    "@types/http-errors": "^2.0.5",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/jest": "^30.0.0",
    "@types/json-schema": "^7.0.15",
    "@types/ms": "^2.1.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-strategy": "^0.2.38",
    "@types/qs": "^6.14.0",
    "@types/range-parser": "^1.2.7",
    "@types/send": "^1.2.0",
    "@types/supertest": "^6.0.2",
    "@types/yargs-parser": "^21.0.3",
    "dotenv": "^16.4.5",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
